{
  "name": "solomon-darker-rust-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "sdmod": "node tools/sdmod/cli.mjs",
    "test:sdmod": "node --test tools/sdmod/cli.test.mjs",
    "dev:desktop": "node tools/run-desktop.mjs",
    "test:desktop": "node --test desktop/*.test.mjs tools/stage-node-runtime.test.mjs tools/desktop-build.test.mjs",
    "package:desktop": "node tools/package-desktop.mjs",
    "package:desktop:windows": "node tools/package-desktop.mjs --platform win32 --arch x64",
    "package:desktop:mac": "node tools/package-desktop.mjs --platform darwin --arch arm64",
    "package:desktop:linux": "node tools/package-desktop.mjs --platform linux --arch x64",
    "archive:desktop": "node tools/archive-desktop.mjs",
    "smoke:desktop": "node tools/smoke-desktop-runtime.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "43.4.0",
    "playwright-core": "1.61.1"
  }
}
