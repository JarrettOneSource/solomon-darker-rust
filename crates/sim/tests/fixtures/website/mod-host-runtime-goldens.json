{"source":"host/prepared-mod-host.ts::prepareModHost,extensions,checkpoint,restore","generator":"mod-host-runtime-goldens.mjs","payload":{"manifestSha256":"1111111111111111111111111111111111111111111111111111111111111111","mods":[{"boneyards":[],"contentSha256":"2222222222222222222222222222222222222222222222222222222222222222","entryScript":"\nlocal icon = sd.art.sprite(\"art/icon.png\")\nlocal status = sd.kit.status({\n  key = \"invincible\",\n  duration = \"100ms\",\n  stacking = \"refresh\",\n  modifiers = {incoming_damage = 0, mana_spend = 0},\n})\nlocal potion = sd.kit.potion({\n  key = \"invincibility_potion\",\n  name = \"Invincibility Potion\",\n  duration = \"100ms\",\n  status = sd.ref(\"status\", \"invincible\"),\n  on_use = sd.rules.all({\n    sd.effect.resource({target = \"user\", mana = \"full\"}),\n    sd.effect.status({target = \"user\", status = sd.ref(\"status\", \"invincible\")}),\n  }),\n  loot = {ordinary = 1, boss = 1},\n  art = {icon = sd.art.ref(\"icon\")},\n})\nlocal powerup = sd.kit.powerup({\n  key = \"survey_orb\",\n  name = \"Survey Orb\",\n  effect = sd.effect.resource({target = \"collector\", mana = \"full\"}),\n  pickup = {radius = 40},\n  art = {world = sd.art.ref(\"icon\")},\n})\nlocal ingredient = sd.kit.item({\n  key = \"ingredient\",\n  name = \"Ingredient\",\n  stack = {maximum = 10},\n  art = {icon = sd.art.ref(\"icon\")},\n})\nlocal shop = sd.kit.shop({\n  key = \"test_shop\",\n  name = \"Test Shop\",\n  stock_scope = \"player\",\n  stock = {{item = sd.ref(\"item\", \"ingredient\"), price = 0, quantity = 2}},\n})\nlocal spell = sd.kit.spell({\n  key = \"gravity_well\",\n  name = \"Gravity Well\",\n  slot = \"secondary\",\n  mana = 30,\n  cooldown = \"1s\",\n  behavior = sd.prefab.area({\n    radius = 180,\n    duration = \"100ms\",\n    every = \"100ms\",\n    effects = {sd.effect.damage({target = \"hostiles_in_area\", amount = 1})},\n  }),\n  art = {icon = sd.art.ref(\"icon\")},\n})\nlocal skill = sd.kit.skill({\n  key = \"gravity_student\",\n  name = \"Gravity Student\",\n  offer = {minimum_level = 2},\n  ranks = {{grant = sd.ref(\"spell\", \"gravity_well\")}},\n  art = {icon = sd.art.ref(\"icon\")},\n})\nlocal enemy = sd.kit.enemy({\n  key = \"grave_tyrant\",\n  name = \"Grave Tyrant\",\n  stats = {health = 250, speed = 2.5},\n  art = {atlas = sd.art.ref(\"icon\")},\n})\nlocal boast = sd.kit.boast({\n  key = \"empty_hands\",\n  name = \"EMPTY HANDS, FULL GLORY!\",\n  statement = [[\"I need neither potion nor enchanted equipment!\"]],\n  response = \"Provokatus nods at your reckless confidence.\",\n  instruction = \"Survive through Wave 25.\",\n  fail_on = {\"potion-use\", \"magical-equipment\", \"secondary-cast\", \"mana-underflow\"},\n  success_wave = 25,\n  score_multiplier = 1.25,\n  stock_icon = 6,\n})\nlocal spawn_content = sd.rules.on(\"run.started\", sd.rules.all({\n  sd.effect.spawn({\n    content = sd.ref(\"powerup\", \"survey_orb\"),\n    x = 10000,\n    y = 10000,\n  }),\n}))\nlocal probe = sd.rules.on(\"gold.changed\", sd.rules.all({\n  sd.effect.damage({target = \"user\", amount = 5}),\n  sd.effect.state({key = \"lesson.ready\", value = true}),\n}))\nlocal remember_purchase = sd.rules.on(\"action.shop.purchase\", sd.effect.state({\n  key = \"shop.first_purchase\",\n  value = true,\n}))\nreturn sd.mod({\n  api = \"1.0.0\",\n  assets = {icon = icon},\n  content = {status, potion, powerup, ingredient, shop, spell, skill, enemy, boast},\n  rules = {spawn_content, probe, remember_purchase},\n})\n","files":[{"byteLength":24,"bytesBase64":"iVBORw0KGgoAAAANSUhEUgAAADUAAAAy","contentType":"image/png","kind":"image","path":"art/icon.png","sha256":"304bcd66a3d43657b4b28280b449acbbd018e3d7d65248fd80329b49a4b1ab36"}],"id":"example.host-content","name":"Host Content","priority":0,"slug":"host-content","version":"1.0.0"}]},"cases":[{"input":{"kind":"checkpoint"},"output":{"enemies":{"enemies":[],"nextId":1,"revision":0},"powerups":{"instances":[],"nextId":1,"revision":0},"scenes":{"next